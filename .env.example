DATABASE_URL="postgresql://postgres:postgres@localhost:5432/questora?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Protected S3/S3-compatible upload foundation.
S3_BUCKET="questora-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="replace-with-access-key"
S3_SECRET_ACCESS_KEY="replace-with-secret-key"
# S3_ENDPOINT="https://s3-compatible-provider.example.com"
# S3_FORCE_PATH_STYLE="false"

# Local AI assistant provider. Ollama must run outside the Next.js app.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Production first-admin bootstrap only. Do not commit real values.
BOOTSTRAP_ADMIN_NAME="Questora Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Future production hardening:
# REDIS_URL="redis://default:password@host:6379"
